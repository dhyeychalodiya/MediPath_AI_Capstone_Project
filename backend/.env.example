PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000,http://localhost:8080

# Keep this on the backend. Enable Places API (Text Search) and billing in Google Cloud.
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Google AI Studio Gemini key for Indian-language normalization and AI recommendations.
GEMINI_API_KEY=your_gemini_api_key

# Optional admin secret key to protect administrative operations (e.g. quota resets)
ADMIN_SECRET_KEY=your_secure_admin_secret_key